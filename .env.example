# Скопировать в .env и заполнить. Файл .env закрыт .gitignore — не коммитить.
#
# Имена переменных должны ТОЧНО соответствовать полям rag/config.py:
# pydantic-settings при несовпадении молча берёт значение по умолчанию,
# и вы получите непонятную ошибку подключения вместо явной.
#
# ВАЖНО: реальный ключ OpenAI живёт только здесь, на бэкенде.
# Фронтенд на Vercel к OpenAI не обращается — он ходит только в этот FastAPI.

# ─── PostgreSQL: Neon, ОТДЕЛЬНЫЙ проект ──────────────────────────────────────
# Не переиспользуйте brain-vectors торгового бота. Бесплатный план Neon даёт
# 0.5 ГБ НА ПРОЕКТ и до 100 проектов: отдельный проект = свои чистые 0.5 ГБ,
# свои бэкапы и гарантия, что ошибка в миграции FAQ не заденет торговые данные.
#
# Строку целиком, вместе с паролем, выдаёт Neon Console при создании проекта —
# придумывать пароль не нужно. Не обрезайте ?sslmode=require.
#
# pgvector в Neon 0.8.x: sparsevec поддерживается; HNSW по sparsevec — до 1000
# ненулевых элементов на вектор (нам индекс на sparse пока не нужен).
#
# Ёмкость: ~14 КБ на чанк с учётом HNSW → 0.5 ГБ ≈ 35 000 чанков ≈ 200 мануалов
# такого размера. При превышении — Neon Launch (10 ГБ, ~$19/мес), а не переезд
# на самохостинг: мини-ПК хорош для вычислений, но не для системы хранения.
# КАВЫЧКИ ОБЯЗАТЕЛЬНЫ: в строке есть ? и &, без кавычек bash споткнётся при
# source, а Makefile читает этот же файл. python-dotenv кавычки снимает сам,
# так что Python и shell получают одно и то же значение.
#
# Берите ПРЯМОЙ эндпоинт, без «-pooler» в хосте. Пулер (PgBouncer в
# transaction-режиме) ломает DDL и prepared statements asyncpg/psycopg3,
# а выигрыша не даёт: у нас один долгоживущий процесс, а не serverless.
DB_DSN="postgresql://neondb_owner:пароль@ep-xxx-xxx.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Нужен ровно в двух местах: contextual prefix при индексации и генерация
# финального ответа. Эмбеддинги и реранкинг локальные — для них OpenAI не нужен.
# Если увидите обращение к OpenAI где-то ещё — это повод разобраться.
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL=gpt-4o-mini

# ─── Локальные модели (CPU) ──────────────────────────────────────────────────
# Первый запуск скачает ~2.3 ГБ на каждую модель в кэш HuggingFace.
EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ─── Бэкенд реранкера ────────────────────────────────────────────────────────
# Реранкер — это 99% времени запроса. Всё остальное вместе (эмбеддинг запроса,
# два запроса в Neon, генерация в OpenAI) меньше секунды. Поэтому здесь один
# переключатель решает, отвечает система за 10 секунд или за 49.
#
#   torch — эталон. FlagReranker, float32. ~36 с на 20 кандидатах.
#           Работает везде и сразу, ничего выгружать не нужно.
#   onnx  — ONNX Runtime, динамическая int8-квантизация. ~8 с на тех же данных.
#           ТРЕБУЕТ выгруженной модели: scripts/export_reranker_onnx.sh
#           (несколько минут, 2.8 ГБ на диск, в git не хранится).
#
# По умолчанию torch И ЭТО НАМЕРЕННО. На свежем клоне и на любой машине без
# выгруженной модели onnx упадёт на старте с FileNotFoundError — молчаливого
# отката нет специально: он дал бы вчетверо более медленный путь и скоры
# в другой шкале, и это заметили бы не сразу. Лучше явная ошибка.
#
# На рабочем сервере (trading-server) в .env стоит onnx. На Mac — torch:
# ONNX-модель туда никто не выгружал, а для отладки ingestion скорость
# реранкера роли не играет.
#
# Качество: golden set 31/32 на обоих бэкендах, падает один и тот же вопрос
# по одной и той же причине. Топ-1 реранкера совпал на 12 из 12 проверенных
# вопросов. Квантизация сдвигает логиты (медиана 0.20, максимум 0.68), но
# только в хвосте, среди заведомо нерелевантных чанков.
RERANKER_BACKEND=torch
RERANKER_ONNX_PATH=models/bge-reranker-onnx-int8

# 512 — это дефолт самого FlagReranker, а не наш выбор; держим явно, чтобы
# снижение было видимым разменом, а не незаметной сменой дефолта. При 512
# 18 чанков из 20 уже обрезаются, то есть хвосты реранкер и так не видит.
# Снижение до 256/128 ускоряет примерно вдвое/вчетверо, но реранкер начинает
# судить о релевантности по началу чанка. Не менять без прогона golden set.
RERANKER_MAX_LENGTH=512

# 1 — не опечатка. На CPU батч не экономит запуски ядер, а упирается в кэш,
# и при bs=1 вдобавок нет паддинга. Замер на 20 кандидатах:
# bs=1 → 8.0 с, bs=8 → 13.4 с, bs=20 → 15.1 с. Действует только на onnx;
# torch-путь батчует сам, внутри FlagEmbedding.
RERANKER_BATCH_SIZE=1

# ─── Параметры поиска ────────────────────────────────────────────────────────
DENSE_TOP_K=50        # кандидатов из dense-ветви
SPARSE_TOP_K=50       # кандидатов из sparse-ветви
RRF_TOP_K=20          # после слияния Reciprocal Rank Fusion → в реранкер
RERANK_TOP_N=6        # финальных чанков в контекст генерации
RRF_K=60              # константа RRF, стандартное значение

# ─── Загрузчик ───────────────────────────────────────────────────────────────
EMBED_BATCH_SIZE=8
CHUNKS_PATH=chunks.json
PREFIX_CACHE_PATH=.prefix_cache.json

# ─── Скор-лог ────────────────────────────────────────────────────────────────
# JSONL, одна строка на запрос: скоры реранкера, бэкенд, строка применимости,
# вердикт grounding-проверки. ТОЛЬКО НАКОПЛЕНИЕ — ни порога отказа, ни
# блокировки по этим данным сейчас нет, они сырьё для будущей калибровки.
# Файл в git не хранится (.gitignore), растёт на строку за запрос.
SCORE_LOG_PATH=score_log.jsonl
